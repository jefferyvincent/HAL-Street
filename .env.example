# HAL Street configuration. Copy to `.env` — that is the only config file there is.
#
# Two Alpaca accounts share this one file, separated by variable name rather than by
# filename:
#
#   ALPACA_*        the dev account.  Used by every command by default.
#   COMP_ALPACA_*   the judged account. Used only by `--env comp`.
#
# Nothing falls back between them: a dev run never reads a COMP_ name, and a comp run
# with no COMP_ keys refuses to start rather than quietly using the dev pair.
#
# PAPER ONLY. A live key (AK…) is refused at startup by three independent checks.

# --- Dev account -------------------------------------------------------------
ALPACA_ENV=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca MCP server. The official server is a stdio subprocess we launch, not a
# hosted endpoint — it takes ALPACA_API_KEY/ALPACA_SECRET_KEY from the environment
# we hand it.
#
# Left unset on purpose. The default in mcp_client.py is
# `uvx --with fastmcp<4 alpaca-mcp-server`, and the pin is load-bearing: setting
# ALPACA_MCP_ARGS here to a bare `alpaca-mcp-server` drops it and the server dies at
# import against fastmcp 4.x. Set these two only to run a checkout or a newer server,
# and carry the pin across if you do.
#ALPACA_MCP_COMMAND=uvx
#ALPACA_MCP_ARGS=--with fastmcp<4 alpaca-mcp-server

# Optional. Leave unset to default to the paper host; the startup assertion refuses
# any value pointing at live.
ALPACA_BASE_URL=

# Options data feed. `indicative` is Alpaca's free feed and the default; `opra` is the
# official OPRA consolidated feed and requires a paid market-data agreement on the
# account. Without that agreement a feed=opra request returns HTTP 403, so leave this
# on indicative unless you have subscribed. Indicative quotes are not the official
# NBBO — record which feed produced any P&L number you publish.
ALPACA_OPTION_FEED=indicative

# Model backend
LLM_PROVIDER=anthropic
# The judge's model: the one stage that picks a structure and writes the rationale
# that reaches the ledger.
LLM_MODEL=claude-opus-5

# The other three committee stages — catalyst, bull, bear — run here. None of them
# decides anything: the catalyst turns headlines into a lean against a closed schema,
# and the researchers write a paragraph each for the judge to read. Measured on the
# 2026-08-27 soak they carry roughly two thirds of the input tokens, which is why
# they are the ones that drop a tier.
#
# Unset, they run on claude-sonnet-5 whatever LLM_MODEL says — it does not fall back
# to it, because every .env here sets LLM_MODEL and inheriting it would mean the
# tiering never engaged for anyone. Set this to LLM_MODEL's value to put the whole
# committee back on one model and measure what the tiering costs in decision quality.
#COMMITTEE_ANALYST_MODEL=claude-sonnet-5

# What a token costs, as {"model": [input, output]} in dollars per million.
#
# Configuration rather than a constant because prices change and differ per account.
# One ships, because it is the one this project can cite: Claude Opus 5 at $5/$25 per
# MTok. The analyst tier's price is not, so its tokens are counted and its cost is
# reported as unknown until you set it here — a visible gap on the console beats a
# total that quietly omits two thirds of the input.
#
# Check current pricing before trusting the figure. Cached reads are counted and left
# out of the arithmetic; they bill at a discount this project has no sourced number
# for, and guessing one would be a guess with a dollar sign in front of it.
#LLM_PRICES={"claude-sonnet-5": [3, 15]}

# Reasoning effort: low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_API_KEY=
LLM_LOCAL_FALLBACK=false

# --- Strategy profile. Chooses how aggressively to *build* — DTE band, delta band,
# which structures, and what the ranking weights. It never chooses risk: where a
# profile disagrees with a limit above, the stricter of the two wins, and the
# disagreement is printed at startup in both directions.
#
#   ultra_conservative  30-60 DTE, 0.10-0.25 delta, verticals only, regime-led
#   conservative        30-60 DTE, 0.15-0.30 delta, verticals only
#   moderate            21-60 DTE, 0.20-0.45 delta, adds iron condors   (default)
#   aggressive           7-45 DTE, 0.30-0.55 delta, direction-led
#   ultra_aggressive     7-45 DTE, 0.30-0.70 delta, reward/risk-led
#
# An unrecognised name refuses to start rather than falling back.
#
# Profile liquidity floors were retuned down from the vendor's after measuring them
# against the live chains — see `strategy/profiles.LiquidityFloor`. The moderate
# profile's daily-volume floor is 5, matching MIN_DAILY_VOLUME below, so neither
# silently overrides the other.
RISK_PROFILE=moderate_short
# `moderate_short` is `moderate`'s judgement on a shorter window: the same 0.20-0.45
# short delta band, the same liquidity floors, the same sizing cap, but a 7-21 day
# band instead of 21-60. It exists so going faster does not also mean selling closer
# to the money — `aggressive` moves three other things at once.
#
# The 7 is the floor and it is load-bearing: Alpaca returns no greeks at same-day
# expiry, so the delta and vega gates fail closed there. MIN_DTE below keeps that true
# whatever the profile says, since the stricter of the two always wins.

# Target days to expiry. Clamped into the profile's band, so a value outside it is
# not an error, just a request the profile declines. 14 sits in the middle of
# moderate_short's 7-21, which is the point of picking it rather than taking the
# ceiling by default.
TARGET_DTE=14

# Risk gate configuration (hard bounds; the model cannot change these)
MAX_LOSS_PER_POSITION_USD=1000
MAX_PORTFOLIO_RISK_PCT=15
# Contracts per name, and the number that decides whether this agent can make money.
#
# It caps *contracts*, not structures: the gate's rule is
# `max_positions_per_underlying * legs`, and a 1:1 spread adds `legs * qty`, so the leg
# count cancels and this value **is** the maximum qty. At the shipped default of 1 the
# only tradeable size was one contract — and on the SPY structure the desk actually
# wanted on 2026-08-28, one contract was $54 of risk against a $1,000 cap and $46 of
# max gain, which is 0.05% of a $90k account for a 49-day hold.
#
# The per-position dollar cap below is the real risk control. This was doing that job
# instead, about eighteen times too tightly, and leaving the dollar cap never binding.
# At 5 the two work together: size is `min(5, cap / risk-per-contract)`, so a $54
# structure goes to 5 and a $1,387 one is still refused outright.
MAX_POSITIONS_PER_UNDERLYING=5
MIN_DTE=7
MIN_OPEN_INTEREST=250
# Contracts traded today. Lowered from 10 after measuring which limit was actually
# binding: on the live 45-DTE chains, volume was rejecting almost everything while
# open interest and spread rejected almost nothing. Holding the rest fixed, a volume
# floor of 25 gave SPY 9 / QQQ 0 / IWM 1 candidates and put the 0.30-0.45 delta band
# out of reach entirely; a floor of 5 gives SPY 19 / QQQ 7 / IWM 9 across every delta.
#
# The bias mattered more than the count. The further out of the money a strike is,
# the less it trades today — so a volume floor selects hardest against exactly the
# OTM structures this strategy is built on, and was quietly pushing the agent toward
# near-the-money spreads with ~50% odds. Above zero, though: "has traded at all
# today" is still a real staleness check.
#
# Open interest and spread are doing the liquidity work, and are unchanged because
# the same sweep showed them not binding — 8% vs 12% spread changed nothing at all.
MIN_DAILY_VOLUME=5
MAX_BID_ASK_WIDTH_PCT=10
MAX_NET_DELTA=5000
MAX_NET_VEGA=100
ASSIGNMENT_MONEYNESS_PCT=2
ASSIGNMENT_DTE=5

# --- Circuit breakers. These judge the situation rather than the proposal, and none
# of them looks at the structure. They guard the failure an autonomous agent actually
# has: not a bad trade, but a runaway. Entries only — exits are never blocked.
#
# Positions' worth of contracts allowed across one basket of names that move together
# (see gates/circuit.py). This exists because the UNIVERSE shipped at the time was SPY,
# QQQ and IWM — one bullish bet wearing three tickers. On 2026-08-26 the agent
# approved put credit spreads on all three in a single scan, and every other gate
# waved it through: the per-underlying cap matches roots exactly, so three roots look
# like three separate names to it.
#
# Counts contracts, like the per-underlying cap, so it has to move with it: left at 2
# while that went to 5, this would become the binding constraint instead and the size
# problem would simply relocate.
MAX_CORRELATED_POSITIONS=5
# Positions' worth of contracts allowed across every name in NO group above.
#
# A separate number because it answers a separate question. "SPY and QQQ move
# together" is a claim about those two names that someone checked; "KO, PEP and MCD
# are in no group" is a claim about the map's coverage, and bounding it is humility
# rather than correlation.
#
# It exists because UNIVERSE stopped being three tickers. While a human picked the
# names, every name was mapped by construction and "in no group" was a deliberate
# choice that the correlation gate waved through. With discovery it is the common
# case. Set to 0 to disable, which restores exactly that wave-through.
MAX_UNCLASSIFIED_POSITIONS=6
# Equity drawdown from the day's open that latches entries off for the rest of the
# session. Latched, not instantaneous — it does not reset when the tape bounces, and
# it survives a restart (journal/circuit.json), because restarting is exactly what
# someone does when an unattended agent starts behaving oddly. Clear it deliberately
# with `--clear-halt`. Set 0 to disable.
DAILY_LOSS_LIMIT_PCT=5
# Runaway guard, not a risk limit. The loop opens at most one position per underlying
# per 30-minute cycle, so this should never fire in normal operation; if it does,
# something is submitting outside the schedule.
MAX_ENTRIES_PER_HOUR=6
# Broker positions (one per contract after leg-netting) the book may hold at once.
MAX_OPEN_POSITIONS=20
# Share of options buying power kept back rather than committed. Note this gate reads
# `options_buying_power`, NOT the headline `buying_power` — measured on the dev
# account with a flat book those are $89,817 and $359,270, because options collateral
# is cash while the headline figure is 4x margin for equities. Every other sizing gate
# measures against equity; as positions accumulate, held collateral drains buying
# power while equity stays flat, so an equity-based ceiling keeps approving trades
# after the broker has stopped being able to accept them.
#
# The reserve exists so there is always something left to *close* with: some exits are
# debits, and being unable to pay one is how a defined-risk position stops being
# defined. Negative disables the gate.
MIN_BUYING_POWER_HEADROOM_PCT=20

# Loop
# --- Exits. Not entry limits: nothing in gates/ applies on the way out, because when
# something has gone wrong you must always be able to close. Percentages are of the
# structure's own max gain / premium, so a $41 condor and an $820 condor manage alike.
# NB the one completed round trip on this account — QQQ 755/765 call credit spread,
# opened and closed on 2026-08-26 — realized **-$9.00** on a $160 credit. A $73.40
# figure was recorded here previously without saying what it measured; the ledger does
# not support it as a realized cost, and the two are different quantities anyway
# (crossing cost against mid is not the same as money kept). One trade is not a
# distribution: measure this again before trusting either number, and note that a
# profit target below the round-trip cost is noise rather than edge whatever that cost
# turns out to be.
TAKE_PROFIT_PCT=25
# Close any position that is up this much, whatever fraction of max gain it is.
# A percentage target is a fraction of whatever the structure happened to be worth, so
# a large winner can sit open at 40% of max gain while its capital does nothing and the
# next trade goes untaken. This is a floor over that, not a replacement — the
# percentage rule still closes structures too small to ever reach it.
# Blank disables it. On a structure whose max gain exceeds this, it caps the winner:
# that is the price of turning the capital over.
TAKE_PROFIT_USD=
# Close a position that has given back this much of its best-ever gain.
# The target rules only ever fire on the way up. A position up $120 that drifts back to
# $30 and then into a loss made every dollar of that gain and kept none of it, and
# neither a profit target nor a stop was going to catch it — the stop is measured from
# the entry, not from the high.
# Does not arm until the peak clears the round-trip cost, so noise cannot trigger it.
# Blank disables it.
GIVEBACK_PCT=


STOP_LOSS_PCT=200
FORCE_CLOSE_DTE=5

# --- Scalping. Faster turnover, with the one guard rail that makes it survivable.
#
# The target comes down so positions are turned over rather than nursed: 25% of the
# credit, not 50%. TAKE_PROFIT_USD is deliberately blank — it *raises* targets, which
# is the opposite of a scalp, and $100 on a $160 credit is slower than the percentage
# it was meant to improve on.
#
# SCALP_FRICTION_MULTIPLE is the guard rail. Friction is $7.50 a leg, so a two-leg
# spread costs $15 to round trip and a condor $30; a target that does not clear that
# is a losing trade that reports as a win. This raises the target to at least N round
# trips rather than refusing the trade — the position is simply held a little longer,
# which is the only thing that actually fixes the arithmetic. Blank disables it.
SCALP_FRICTION_MULTIPLE=2

# --- Overnight. Flat unless the position earned the hold.
#
# Minutes before the session close at which the book is swept. Blank disables it.
# Three vetoes flatten a position: it is down, an event is scheduled before the next
# session, or the calendar could not be read — the last for the same reason every gate
# fails closed. Anything else is held, because a nightly flatten pays $15-30 a
# structure to avoid roughly $3.50 of decay and loses on that trade every time.
#
# The clock is the broker's. If it cannot be read the sweep does not arm at all: a
# flatten fired against a guess about the time would sell into a shut market.
FLATTEN_BEFORE_CLOSE_MIN=15

# --- Learning from losses. The half the model cannot argue with.
#
# The committee's judge is already handed this desk's closed trades on the underlying,
# with their realized P&L. That is advice, and a confident model can talk its way past
# advice — a proposal arriving with a paragraph about why *this* time is different is
# what a losing streak looks like from the inside.
#
# So `loss-cooldown` rests a losing (underlying, family) pair outright. Two losses in a
# row, because one is a trade and two is a pattern; and the *pair*, not the symbol,
# because being wrong twice about calls says nothing about puts and benching the whole
# name throws away the half of the book that was never tested.
#
# The record is recomputed from the ledger every cycle rather than stored — a second
# file tracking streaks would be a second claim to keep in step, and the day they
# disagreed the agent would bench a pair that had just won. A win clears the run.
#
# LOSS_COOLDOWN_AFTER=0 turns the rule off. LOSS_COOLDOWN_DAYS=0 is not "off": it rests
# the pair for the remainder of the session it lost on.
LOSS_COOLDOWN_AFTER=2
LOSS_COOLDOWN_DAYS=1


# Scan cadence. Read by the scheduler, which only runs while the broker's own
# clock says the market is open — a local clock knows nothing about holidays.
SCAN_INTERVAL_MINUTES=30
# --- The universe. What the agent scans, and where that list comes from.
#
# `auto` (the default) discovers it: every pass reads the market-wide news feed, counts
# the symbols the PUBLISHER tagged on each article, and takes the most-mentioned names
# that survive a tradability screen. Counting runs on Benzinga's structured `symbols`
# field and never on the headline text — see marketdata/discovery.py for why that line
# matters and marketdata/news.py for who drew it.
#
# An explicit comma-separated list pins exactly those names instead. Do that for any
# run that has to be reproducible — a judged run, a bug in one symbol — because a
# discovered universe is a function of what the tape said that morning.
#
# `SPY,QQQ,IWM` was the shipped default and is still a reasonable one. It is also one
# bullish bet in three tickers; see MAX_CORRELATED_POSITIONS above.
UNIVERSE=auto

# Names handed to the scan per pass, at most. The binding constraint is cost, not
# taste: every symbol is a full committee — catalyst, bull, bear, judge — so this
# multiplies the model spend of a cycle directly.
DISCOVERY_LIMIT=6
DRY_RUN=true

# Committee mode, and the default is ON — leave this unset or set it to true.
#
# On: a catalyst analyst reads the tape's headlines, a bull and a bear argue the same
# evidence in parallel, and a judge decides — four model calls per underlying instead
# of one. Off: a single call picks from the ranked menu, and THE AGENT NEVER READS THE
# NEWS, because the headline fetch lives on the committee path alone. Everything else
# the model is shown — HV rank, indicator votes, the six-term score — is arithmetic
# that already ran deterministically. Off, it trades on the math and nothing else.
#
# Set it to false for a cheap demo or if you are rate-limited. Budget roughly four
# times the tokens: with a universe of three and a 30-minute cadence, a session is
# about 156 calls rather than 39.
#
# Either way it changes how a proposal is *reached*, never what is permitted: whichever
# path produced it, the proposal meets the same sixteen gates. More deliberation can
# make a better proposal; it can never make a forbidden one allowed.
#COMMITTEE=false

# --- Competition account (judged run only; read only by `--env comp`) --------
# Must be a BRAND-NEW paper account with a $100,000 starting balance — a different
# Alpaca account from the one above, not the same keys pasted twice. Reused accounts
# are ineligible for judging; `./start.sh preflight --env comp` enforces both.
# Leave these blank until the account exists. Blank is what stops a comp run.
COMP_ALPACA_API_KEY=
COMP_ALPACA_SECRET_KEY=
COMP_REQUIRED_EQUITY=100000
