# Alpaca — PAPER ONLY. Startup asserts this and refuses live keys.
ALPACA_ENV=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca MCP server
ALPACA_MCP_URL=
ALPACA_MCP_TOKEN=

# Model backend
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_LOCAL_FALLBACK=false

# Risk gate configuration (hard bounds; the model cannot change these)
MAX_LOSS_PER_POSITION_USD=250
MAX_PORTFOLIO_RISK_PCT=15
MAX_POSITIONS_PER_UNDERLYING=1
MIN_DTE=7
MIN_OPEN_INTEREST=250
MAX_BID_ASK_WIDTH_PCT=10

# Loop
SCAN_INTERVAL_MINUTES=30
UNIVERSE=SPY,QQQ,IWM
DRY_RUN=true

# --- Competition account (judged run only; keep in .env.comp, never .env) ---
# Must be a BRAND-NEW paper account with a $100,000 starting balance.
# Reused accounts are ineligible for judging. scripts/preflight.py enforces this.
COMP_ALPACA_API_KEY=
COMP_ALPACA_SECRET_KEY=
COMP_REQUIRED_EQUITY=100000
